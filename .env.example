NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Prefer the immutable user ID from Supabase Authentication > Users.
SITE_OWNER_USER_ID=
# Fallback only: a confirmed email. Ignored when SITE_OWNER_USER_ID is set.
SITE_OWNER_EMAIL=your-account@example.com
# Enable each only AFTER configuring and testing that provider in Supabase.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_AUTH_NAVER_ENABLED=false
NEXT_PUBLIC_AUTH_KAKAO_ENABLED=false
# Public project inquiries are stored in the project_inquiries table from supabase/schema.sql.

# BOTTOPIA Canvas (server-only; see docs/CANVAS.md)
# Blank/missing keeps paid generation OFF. Never use NEXT_PUBLIC_ for these keys.
KIE_API_KEY=
OPENSAND_API_KEY=
BEATAPI_API_KEY=
# Set exactly true only when deliberately enabling owner-only paid jobs.
CANVAS_GENERATION_ENABLED=
# Optional independent signing secret, at least32characters; rotation invalidates receipts.
CANVAS_JOB_SECRET=
# Optional: uncomment and set opensand or beat; omitted defaults to opensand.
# OpenSand exact2.5 request schema is pending and cannot generate.
# CANVAS_VIDEO_PROVIDER=
