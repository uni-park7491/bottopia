NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
# Prefer the immutable user ID from Supabase Authentication > Users.
SITE_OWNER_USER_ID=
# Fallback only: a confirmed email. Ignored when SITE_OWNER_USER_ID is set.
SITE_OWNER_EMAIL=your-account@example.com
# Enable each only AFTER configuring and testing that provider in Supabase.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
NEXT_PUBLIC_AUTH_NAVER_ENABLED=false
NEXT_PUBLIC_AUTH_KAKAO_ENABLED=false
# Public project inquiries are stored in the project_inquiries table from supabase/schema.sql.
